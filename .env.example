# Postgres superuser (only used for first-time setup)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# App databases
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
LIBRARY_DB_PASSWORD=change-me-library-db

# Keycloak (pin a specific version; check keycloak.org/downloads)
KEYCLOAK_VERSION=26.5.1
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin

# Keycloak Admin API ("library-backend" service account; deploy.sh strips the dev secret from
# the generated prod realm, so Keycloak assigns a real one on import - copy it here from the
# admin console: realm library -> Clients -> library-backend -> Credentials)
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-admin-client-secret